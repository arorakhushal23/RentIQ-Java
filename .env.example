# ============================================================================
# RentIQ Database Environment Configuration Example
# Copy this file to .env and configure with your local MySQL credentials.
# DO NOT commit real passwords or production credentials to Git!
# ============================================================================

# Database Connection URL (Defaults to localhost:3306 with database rentiq_db)
RENTIQ_DB_URL=jdbc:mysql://localhost:3306/rentiq_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Database Username
RENTIQ_DB_USERNAME=root

# Database Password
RENTIQ_DB_PASSWORD=your_secure_password_here
